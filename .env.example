NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOSATHI_API_BASE_URL=http://8.234.86.28:8000
NEXT_PUBLIC_API_BASE_URL=/api/skyclip
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DISCOVERY_MODE=api
# Browser-visible Mapillary client token. Restrict its authorized origins in Mapillary settings.
NEXT_PUBLIC_MAPILLARY_ACCESS_TOKEN=
# Private server token for same-origin image lookup. The browser token above is for the viewer only.
MAPILLARY_ACCESS_TOKEN=
# Public, domain-restricted MapTiler browser key. Enables the optional satellite basemap.
NEXT_PUBLIC_MAPTILER_API_KEY=
# Private SkyCLIP configuration; never use NEXT_PUBLIC_ for these.
SKYCLIP_BASE_URL=
SKYCLIP_SERVICE_TOKEN=
# REQUIRED only for real Sentinel-2 L2A land-cover queries; Vercel server secrets, never NEXT_PUBLIC.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

SEGMENTATION_API_URL=https://geosathi-segmentation-api-883668519860.asia-south1.run.app
